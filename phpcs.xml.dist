<?xml version="1.0"?>
<ruleset name="Certant Knowledgebase">
	<description>WordPress Coding Standards and PHP 7.4+ compatibility.</description>

	<file>certant-knowledgebase.php</file>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.0"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="certant-knowledgebase"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="certant_kb"/>
			</property>
		</properties>
	</rule>
</ruleset>
